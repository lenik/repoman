#!/bin/bash
# Copyright (C) 2026 Lenik <repoman@bodz.net>
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail

TOOL_NAME=drm
DRM_VERSION=@PROJECT_VERSION@
TEXTDOMAIN=@DRM_TEXTDOMAIN@
INSTALL_LOCALEDIR=@DRM_INSTALL_LOCALEDIR@
SOURCE_LOCALEDIR=@DRM_SOURCE_LOCALEDIR@
BUILD_LOCALEDIR=@DRM_BUILD_LOCALEDIR@

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHARE_DIR=""
if [[ -f "$SCRIPT_DIR/share/common.sh" ]]; then
    SHARE_DIR="$SCRIPT_DIR/share"
elif [[ -n "${REPOMAN_SHARE_DIR:-}" ]]; then
    SHARE_DIR="$REPOMAN_SHARE_DIR"
else
    for candidate in \
        "/usr/share/repoman" \
        "/usr/local/share/repoman"; do
        if [[ -f "$candidate/common.sh" ]]; then
            SHARE_DIR="$candidate"
            break
        fi
    done
fi

# Meson out-of-tree build: build/drm with share/ at source root.
if [[ -z "$SHARE_DIR" && -f "$SCRIPT_DIR/../share/common.sh" ]]; then
    SHARE_DIR="$(cd "$SCRIPT_DIR/../share" && pwd)"
fi

if [[ -z "${SHARE_DIR:-}" || ! -f "$SHARE_DIR/common.sh" ]]; then
    printf '%s: %s\n' "$TOOL_NAME" "could not find drm library scripts" >&2
    exit 1
fi

# shellcheck source=share/i18n.sh
source "$SHARE_DIR/i18n.sh"
# shellcheck source=share/logstyle.sh
source "$SHARE_DIR/logstyle.sh"
# shellcheck source=share/common.sh
source "$SHARE_DIR/common.sh"
# shellcheck source=share/seed/drm.sh
source "$SHARE_DIR/seed/drm.sh"
# shellcheck source=share/var/docker.sh
source "$SHARE_DIR/var/docker.sh"

init_drm() {
    if [[ -n "${DRM_STATE_DIR:-}" ]]; then
        :
    elif [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
        DRM_STATE_DIR="$XDG_CONFIG_HOME/repoman/drm"
    else
        DRM_STATE_DIR="$HOME/.config/repoman/drm"
    fi
    MIRROR_FILE="$DRM_STATE_DIR/mirrors"
    DEFAULT_FILE="$DRM_STATE_DIR/default"
    HEALTH_FILE="$DRM_STATE_DIR/health"
    PREFERRED_FILE="$DRM_STATE_DIR/preferred"
    mkdir -p "$DRM_STATE_DIR"
    vlog2 "state directory: $DRM_STATE_DIR"
}

ensure_state_paths() {
    [[ -n "${MIRROR_FILE:-}" ]] || \
        die "$(_ 'internal error: call init_drm before mirror commands')"
}

GETBAR="${DRM_GETBAR:-$GETBAR}"
GETBAR_OPTS="${DRM_GETBAR_OPTS:-$GETBAR_OPTS}"
BWTEST_REF_BYTES="${DRM_BWTEST_REF_BYTES:-$BWTEST_REF_BYTES}"

VERBOSE=0
QUIET=0
DRM_CONFIG_ONLY=0
LIST_PRIORITY=0
LIST_CHAR=0
PING_COUNT=3
PING_TIMEOUT=2

usage() {
    cat <<EOF
$(_ 'Usage: drm [OPTION]... COMMAND [ARGS]...')

$(_ 'Manage Docker registry mirrors and select the fastest one.')

$(_ 'Options:')
$(_ '  -v, --verbose      more logging (repeatable: -v tests, -vv paths, -vvv metrics, -vvvv trace)')
$(_ '  -q, --quiet        less logging')
$(_ '  -h, --help         show this help')
$(_ '      --version      show version')

$(_ 'Commands:')
$(_ '  list [-c|--char] [-p|--priority]')
$(_ '                     list mirrors: MARK [N] ALIAS (emoji default; -c: * in use, x failed, + fastest, v ok, ? untested)')
$(_ '  add [[-PRIORITY] | -p|--priority N] ALIAS URL')
$(_ '                     add or update a registry mirror (default priority 100)')
$(_ '  remove ALIAS|NUM   remove a mirror')
$(_ '  use [-c|--config-only] ALIAS|NUM')
$(_ '                     set registry-mirrors in /etc/docker/daemon.json')
$(_ '  pingtest [-n|--count N] [-W|--timeout SEC]')
$(_ '                     ping all mirrors; list by latency')
$(_ '  bwtest [--ref BYTES]')
$(_ '                     download test on all mirrors; list by score')
$(_ '  pingsel [-c|--config-only] [-n|--count N] [-W|--timeout SEC]')
$(_ '                     pingtest then use the best mirror')
$(_ '  bwsel [-c|--config-only] [--ref BYTES]')
$(_ '                     bwtest then use the best mirror')
$(_ '  help               show this help')
$(_ '  version            show version')
EOF
}

version() {
    printf '%s %s\n' "$TOOL_NAME" "$DRM_VERSION"
}

cmd_list() {
    LIST_PRIORITY=0
    LIST_CHAR=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -p|--priority) LIST_PRIORITY=1; shift ;;
        -c|--char) LIST_CHAR=1; shift ;;
        -h|--help) usage; exit 0 ;;
        -*) die "$(_ 'usage: drm list [-c|--char] [-p|--priority]')" ;;
        *) die "$(_ 'usage: drm list [-c|--char] [-p|--priority]')" ;;
        esac
    done
    export LIST_PRIORITY LIST_CHAR
    ensure_mirrors
    if ((${#MIRROR_ALIASES[@]} == 0)); then
        log "$(_ 'no mirrors configured')"
        return 0
    fi
    list_mirrors_sorted
}

cmd_add() {
    local priority=100
    local alias url

    while [[ $# -gt 0 ]]; do
        case "$1" in
        -p|--priority)
            [[ $# -ge 2 ]] || die "$(_ 'usage: drm add [[-PRIORITY] | -p|--priority N] ALIAS URL')"
            priority="$2"
            shift 2
            ;;
        -[0-9]*)
            priority="${1#-}"
            shift
            ;;
        -h|--help) usage; exit 0 ;;
        -*) die "$(_ 'usage: drm add [[-PRIORITY] | -p|--priority N] ALIAS URL')" ;;
        *) break ;;
        esac
    done
    if [[ $# -ne 2 ]]; then
        die "$(_ 'usage: drm add [[-PRIORITY] | -p|--priority N] ALIAS URL')"
    fi
    alias="$1"
    url="$2"
    validate_alias "$alias"
    validate_url "$url"
    invalidate_mirrors_cache
    load_mirrors
    mirror_add "$alias" "$priority" "$url"
    save_mirrors
    log "$(printf "$(_ 'added %s (priority %s) %s')" "$alias" "$priority" "$url")"
}

cmd_remove() {
    local target
    if [[ $# -ne 1 ]]; then
        die "$(_ 'usage: drm remove ALIAS|NUM')"
    fi
    invalidate_mirrors_cache
    load_mirrors
    target="$(mirror_resolve_alias "$1")"
    mirror_remove "$target"
    save_mirrors
    log "$(printf "$(_ 'removed %s')" "$target")"
}

cmd_use() {
    parse_apply_opts "$@"
    ensure_mirrors
    mirror_use "$PARSE_APPLY_TARGET"
}

parse_pingtest_opts() {
    PING_COUNT=3
    PING_TIMEOUT=2
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -n|--count)
            [[ $# -ge 2 ]] || die "$(_ 'usage: drm pingtest [-n|--count N] [-W|--timeout SEC]')"
            PING_COUNT="$2"
            shift 2
            ;;
        -W|--timeout)
            [[ $# -ge 2 ]] || die "$(_ 'usage: drm pingtest [-n|--count N] [-W|--timeout SEC]')"
            PING_TIMEOUT="$2"
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        -*) die "$(_ 'usage: drm pingtest [-n|--count N] [-W|--timeout SEC]')" ;;
        *) die "$(_ 'usage: drm pingtest [-n|--count N] [-W|--timeout SEC]')" ;;
        esac
    done
    export PING_COUNT PING_TIMEOUT
}

parse_bwtest_opts() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --ref)
            [[ $# -ge 2 ]] || die "$(_ 'usage: drm bwtest [--ref BYTES]')"
            BWTEST_REF_BYTES="$2"
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        -*) die "$(_ 'usage: drm bwtest [--ref BYTES]')" ;;
        *) die "$(_ 'usage: drm bwtest [--ref BYTES]')" ;;
        esac
    done
    export BWTEST_REF_BYTES
}

cmd_pingtest() {
    parse_pingtest_opts "$@"
    ensure_mirrors
    run_pingtest
}

cmd_bwtest() {
    parse_bwtest_opts "$@"
    ensure_mirrors
    run_bwtest
}

cmd_pingsel() {
    parse_sel_opts "$@"
    ensure_mirrors
    local tmp best
    tmp="$(mktemp "${TMPDIR:-/tmp}/drm-pingsel.XXXXXX")"
    run_pingtest >"$tmp"
    best="$(awk 'NR==1 {print $1}' "$tmp")"
    rm -f "$tmp"
    [[ -n "$best" ]] || die "$(_ 'no mirror passed ping test')"
    mirror_use "$best"
    log "$(printf "$(_ 'selected %s (lowest latency)')" "$best")"
}

cmd_bwsel() {
    parse_sel_opts "$@"
    ensure_mirrors
    local tmp best
    tmp="$(mktemp "${TMPDIR:-/tmp}/drm-bwsel.XXXXXX")"
    run_bwtest >"$tmp"
    best="$(awk 'NR==1 {print $1}' "$tmp")"
    rm -f "$tmp"
    [[ -n "$best" ]] || die "$(_ 'no mirror passed bandwidth test')"
    mirror_use "$best"
    log "$(printf "$(_ 'selected %s (highest score)')" "$best")"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -v*)
            local opt="${1#-}"
            local i
            for ((i = 0; i < ${#opt}; i++)); do
                case "${opt:i:1}" in
                v) VERBOSE=$((VERBOSE + 1)) ;;
                *) die "$(printf "$(_ 'unknown option: -%s')" "$opt")" ;;
                esac
            done
            shift
            ;;
        --verbose)
            VERBOSE=$((VERBOSE + 1))
            shift
            ;;
        -q|--quiet) QUIET=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --version) version; exit 0 ;;
        --) shift; break ;;
        -*) die "$(printf "$(_ 'unknown option: %s')" "$1")" ;;
        *) break ;;
        esac
    done

    if [[ $# -lt 1 ]]; then
        usage >&2
        exit 1
    fi

    export VERBOSE QUIET
    init_drm

    local cmd="$1"
    shift
    vlog2 "command: $cmd $*"
    case "$cmd" in
    list) cmd_list "$@" ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    use) cmd_use "$@" ;;
    pingtest) cmd_pingtest "$@" ;;
    bwtest) cmd_bwtest "$@" ;;
    pingsel) cmd_pingsel "$@" ;;
    bwsel) cmd_bwsel "$@" ;;
    help) usage ;;
    version) version ;;
    *)
        die "$(printf "$(_ 'unknown command: %s')" "$cmd")"
        ;;
    esac
}

main "$@"
