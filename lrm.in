#!/bin/bash
# Copyright (C) 2026 Lenik <repoman@bodz.net>
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail

TOOL_NAME=lrm
LRM_VERSION=@PROJECT_VERSION@
TEXTDOMAIN=@LRM_TEXTDOMAIN@
INSTALL_LOCALEDIR=@LRM_INSTALL_LOCALEDIR@
SOURCE_LOCALEDIR=@LRM_SOURCE_LOCALEDIR@
BUILD_LOCALEDIR=@LRM_BUILD_LOCALEDIR@

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHARE_DIR=""
if [[ -f "$SCRIPT_DIR/share/common.sh" ]]; then
    SHARE_DIR="$SCRIPT_DIR/share"
elif [[ -n "${REPOMAN_SHARE_DIR:-}" ]]; then
    SHARE_DIR="$REPOMAN_SHARE_DIR"
else
    for candidate in \
        "/usr/share/repoman" \
        "/usr/local/share/repoman"; do
        if [[ -f "$candidate/common.sh" ]]; then
            SHARE_DIR="$candidate"
            break
        fi
    done
fi

# Meson out-of-tree build: build/lrm with share/ at source root.
if [[ -z "$SHARE_DIR" && -f "$SCRIPT_DIR/../share/common.sh" ]]; then
    SHARE_DIR="$(cd "$SCRIPT_DIR/../share" && pwd)"
fi

if [[ -z "${SHARE_DIR:-}" || ! -f "$SHARE_DIR/common.sh" ]]; then
    printf '%s: %s\n' "$TOOL_NAME" "could not find lrm library scripts" >&2
    exit 1
fi

# shellcheck source=share/i18n.sh
source "$SHARE_DIR/i18n.sh"
# shellcheck source=share/logstyle.sh
source "$SHARE_DIR/logstyle.sh"
# shellcheck source=share/common.sh
source "$SHARE_DIR/common.sh"
# shellcheck source=share/detect.sh
source "$SHARE_DIR/detect.sh"
# shellcheck source=share/seed/lrm.sh
source "$SHARE_DIR/seed/lrm.sh"

init_lrm() {
    if [[ -n "${LRM_STATE_DIR:-}" ]]; then
        :
    elif [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
        LRM_STATE_DIR="$XDG_CONFIG_HOME/repoman/lrm"
    else
        LRM_STATE_DIR="$HOME/.config/repoman/lrm"
    fi
    mkdir -p "$LRM_STATE_DIR"
    vlog2 "state directory: $LRM_STATE_DIR"
}

_lrm_migrate_legacy_state() {
    local key="$1"
    local host_spec host_key legacy_mirror legacy_default legacy_health
    local legacy_dir migrated=0
    local saved_id="${LRM_DISTRO_ID:-}"
    local saved_release="${LRM_RELEASE:-}"
    local saved_distro="${LRM_DISTRO:-}"
    local saved_key="${LRM_DISTRO_KEY:-}"

    legacy_mirror="$LRM_STATE_DIR/mirrors"
    legacy_default="$LRM_STATE_DIR/default"
    legacy_health="$LRM_STATE_DIR/health"

    host_spec="$(detect_host_distro_spec)"
    [[ "$host_spec" != unknown ]] || return 0
    parse_distro_spec "$host_spec"
    host_key="$(distro_spec_to_state_key "$LRM_DISTRO_ID" "$LRM_RELEASE")"
    LRM_DISTRO_ID="$saved_id"
    LRM_RELEASE="$saved_release"
    LRM_DISTRO="$saved_distro"
    LRM_DISTRO_KEY="$saved_key"
    [[ "$key" == "$host_key" ]] || return 0

    if [[ -f "$legacy_mirror" && ! -f "$MIRROR_FILE" ]]; then
        cp -a "$legacy_mirror" "$MIRROR_FILE"
        migrated=1
    fi
    if [[ -f "$legacy_default" && ! -f "$DEFAULT_FILE" ]]; then
        cp -a "$legacy_default" "$DEFAULT_FILE"
        migrated=1
    fi
    if [[ -f "$legacy_health" && ! -f "$HEALTH_FILE" ]]; then
        cp -a "$legacy_health" "$HEALTH_FILE"
        migrated=1
    fi

    if [[ "$key" == */* ]]; then
        legacy_dir="${key%%/*}"
        if [[ -f "$LRM_STATE_DIR/$legacy_dir/mirrors" && ! -f "$MIRROR_FILE" ]]; then
            cp -a "$LRM_STATE_DIR/$legacy_dir/mirrors" "$MIRROR_FILE"
            migrated=1
        fi
        if [[ -f "$LRM_STATE_DIR/$legacy_dir/default" && ! -f "$DEFAULT_FILE" ]]; then
            cp -a "$LRM_STATE_DIR/$legacy_dir/default" "$DEFAULT_FILE"
            migrated=1
        fi
        if [[ -f "$LRM_STATE_DIR/$legacy_dir/health" && ! -f "$HEALTH_FILE" ]]; then
            cp -a "$LRM_STATE_DIR/$legacy_dir/health" "$HEALTH_FILE"
            migrated=1
        fi
    fi

    if ((migrated)); then
        rm -f "$legacy_mirror" "$legacy_default" "$legacy_health"
        if [[ "$key" == */* ]]; then
            legacy_dir="${key%%/*}"
            rmdir "$LRM_STATE_DIR/$legacy_dir" 2>/dev/null || true
        fi
        vlog2 "migrated legacy state into $LRM_STATE_DIR/$key/"
    fi
}

lrm_set_distro_state() {
    local key="${LRM_DISTRO_KEY:-${LRM_DISTRO:?}}"

    [[ -n "${LRM_STATE_DIR:-}" ]] || die "$(_ 'internal error: call init_lrm before load_distro_backend')"

    MIRROR_FILE="$LRM_STATE_DIR/$key/mirrors"
    DEFAULT_FILE="$LRM_STATE_DIR/$key/default"
    HEALTH_FILE="$LRM_STATE_DIR/$key/health"
    PREFERRED_FILE="$LRM_STATE_DIR/$key/preferred"
    mkdir -p "$LRM_STATE_DIR/$key"
    _lrm_migrate_legacy_state "$key"
    invalidate_mirrors_cache
    unset HEALTH_LOADED
    vlog2 "distro state: $LRM_STATE_DIR/$key/"
}

ensure_state_paths() {
    if [[ -n "${MIRROR_FILE:-}" ]]; then
        return 0
    fi
    [[ -n "${LRM_DISTRO_ID:-}${LRM_DISTRO:-}" && -n "${LRM_STATE_DIR:-}" ]] || \
        die "$(_ 'internal error: call init_lrm and load_distro_backend before mirror commands')"
    lrm_set_distro_state
}

# Prefer legacy LRM_* env overrides when set.
GETBAR="${LRM_GETBAR:-$GETBAR}"
GETBAR_OPTS="${LRM_GETBAR_OPTS:-$GETBAR_OPTS}"
BWTEST_REF_BYTES="${LRM_BWTEST_REF_BYTES:-$BWTEST_REF_BYTES}"

VERBOSE=0
QUIET=0
LRM_DISTRO=""
LRM_CONFIG_ONLY=0
LIST_PRIORITY=0
LIST_CHAR=0
PING_COUNT=3
PING_TIMEOUT=2

usage() {
    cat <<EOF
$(_ 'Usage: lrm [OPTION]... COMMAND [ARGS]...')

$(_ 'Manage distribution package mirrors and select the fastest one.')

$(_ 'Options:')
$(_ '  -v, --verbose      more logging (repeatable: -v tests, -vv paths, -vvv metrics, -vvvv trace)')
$(_ '  -q, --quiet        less logging')
$(_ '  -o, --distro SPEC  target distribution[:release] (default: detect from host)')
$(_ '                     e.g. debian:bookworm, ubuntu:focal, centos:7')
$(_ '  -l, --list-distros list supported distribution names')
$(_ '  -h, --help         show this help')
$(_ '      --version      show version')

$(_ 'Commands:')
$(_ '  list [-c|--char] [-p|--priority]')
$(_ '                     list mirrors: MARK [N] ALIAS (emoji default; -c: * in use, x failed, + fastest, v ok, ? untested)')
$(_ '  add [[-PRIORITY] | -p|--priority N] ALIAS URL')
$(_ '                     add or update a mirror (default priority 100)')
$(_ '  remove ALIAS|NUM   remove a mirror')
$(_ '  use [-c|--config-only] [apply opts] ALIAS|NUM')
$(_ '                     Debian: [-a|--all] [-s|--src] [-u|--updates] [-b|--backports]')
$(_ '                     [--security] [--suite SUITE]')
$(_ '                     RPM: [-e|--everything] [-E|--epel] [-a|--all] [--releasever VER]')
$(_ '                     [--arch ARCH] [--appstream] [--crb|--powertools] [--minimal]')
$(_ '                     apply mirror (Debian default: all components; RPM default: BaseOS)')
$(_ '  pingtest [-n|--count N] [-W|--timeout SEC]')
$(_ '                     ping all mirrors; list by latency')
$(_ '  bwtest [--ref BYTES]')
$(_ '                     download test on all mirrors; list by score')
$(_ '  pingsel [apply opts] [-n|--count N] [-W|--timeout SEC]')
$(_ '                     pingtest then use the best mirror')
$(_ '  bwsel [apply opts] [--ref BYTES]')
$(_ '                     bwtest then use the best mirror')
$(_ '  help               show this help')
$(_ '  version            show version')
EOF
}

version() {
    printf '%s %s\n' "$TOOL_NAME" "$LRM_VERSION"
}

cmd_list() {
    LIST_PRIORITY=0
    LIST_CHAR=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -p|--priority) LIST_PRIORITY=1; shift ;;
        -c|--char) LIST_CHAR=1; shift ;;
        -h|--help) usage; exit 0 ;;
        -*) die "$(_ 'usage: lrm list [-c|--char] [-p|--priority]')" ;;
        *) die "$(_ 'usage: lrm list [-c|--char] [-p|--priority]')" ;;
        esac
    done
    export LIST_PRIORITY LIST_CHAR
    ensure_mirrors
    if ((${#MIRROR_ALIASES[@]} == 0)); then
        log "$(_ 'no mirrors configured')"
        return 0
    fi
    list_mirrors_sorted
}

cmd_add() {
    local priority=100
    local alias url

    while [[ $# -gt 0 ]]; do
        case "$1" in
        -p|--priority)
            [[ $# -ge 2 ]] || die "$(_ 'usage: lrm add [[-PRIORITY] | -p|--priority N] ALIAS URL')"
            priority="$2"
            shift 2
            ;;
        -[0-9]*)
            priority="${1#-}"
            shift
            ;;
        -h|--help) usage; exit 0 ;;
        -*) die "$(_ 'usage: lrm add [[-PRIORITY] | -p|--priority N] ALIAS URL')" ;;
        *) break ;;
        esac
    done
    if [[ $# -ne 2 ]]; then
        die "$(_ 'usage: lrm add [[-PRIORITY] | -p|--priority N] ALIAS URL')"
    fi
    alias="$1"
    url="$2"
    validate_alias "$alias"
    validate_url "$url"
    invalidate_mirrors_cache
    load_mirrors
    mirror_add "$alias" "$priority" "$url"
    save_mirrors
    log "$(printf "$(_ 'added %s (priority %s) %s')" "$alias" "$priority" "$url")"
}

cmd_remove() {
    local target
    if [[ $# -ne 1 ]]; then
        die "$(_ 'usage: lrm remove ALIAS|NUM')"
    fi
    invalidate_mirrors_cache
    load_mirrors
    target="$(mirror_resolve_alias "$1")"
    mirror_remove "$target"
    save_mirrors
    log "$(printf "$(_ 'removed %s')" "$target")"
}

cmd_use() {
    parse_apply_opts "$@"
    ensure_mirrors
    mirror_use "$PARSE_APPLY_TARGET"
}

parse_pingtest_opts() {
    PING_COUNT=3
    PING_TIMEOUT=2
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -n|--count)
            [[ $# -ge 2 ]] || die "$(_ 'usage: lrm pingtest [-n|--count N] [-W|--timeout SEC]')"
            PING_COUNT="$2"
            shift 2
            ;;
        -W|--timeout)
            [[ $# -ge 2 ]] || die "$(_ 'usage: lrm pingtest [-n|--count N] [-W|--timeout SEC]')"
            PING_TIMEOUT="$2"
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        -*) die "$(_ 'usage: lrm pingtest [-n|--count N] [-W|--timeout SEC]')" ;;
        *) die "$(_ 'usage: lrm pingtest [-n|--count N] [-W|--timeout SEC]')" ;;
        esac
    done
    export PING_COUNT PING_TIMEOUT
}

parse_bwtest_opts() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --ref)
            [[ $# -ge 2 ]] || die "$(_ 'usage: lrm bwtest [--ref BYTES]')"
            BWTEST_REF_BYTES="$2"
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        -*) die "$(_ 'usage: lrm bwtest [--ref BYTES]')" ;;
        *) die "$(_ 'usage: lrm bwtest [--ref BYTES]')" ;;
        esac
    done
    export BWTEST_REF_BYTES
}

cmd_pingtest() {
    parse_pingtest_opts "$@"
    ensure_mirrors
    run_pingtest
}

cmd_bwtest() {
    parse_bwtest_opts "$@"
    ensure_mirrors
    run_bwtest
}

cmd_pingsel() {
    parse_sel_opts "$@"
    ensure_mirrors
    local tmp best
    tmp="$(mktemp "${TMPDIR:-/tmp}/lrm-pingsel.XXXXXX")"
    run_pingtest >"$tmp"
    best="$(awk 'NR==1 {print $1}' "$tmp")"
    rm -f "$tmp"
    [[ -n "$best" ]] || die "$(_ 'no mirror passed ping test')"
    mirror_use "$best"
    log "$(printf "$(_ 'selected %s (lowest latency)')" "$best")"
}

cmd_bwsel() {
    parse_sel_opts "$@"
    ensure_mirrors
    local tmp best
    tmp="$(mktemp "${TMPDIR:-/tmp}/lrm-bwsel.XXXXXX")"
    run_bwtest >"$tmp"
    best="$(awk 'NR==1 {print $1}' "$tmp")"
    rm -f "$tmp"
    [[ -n "$best" ]] || die "$(_ 'no mirror passed bandwidth test')"
    mirror_use "$best"
    log "$(printf "$(_ 'selected %s (highest score)')" "$best")"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -v*)
            local opt="${1#-}"
            local i
            for ((i = 0; i < ${#opt}; i++)); do
                case "${opt:i:1}" in
                v) VERBOSE=$((VERBOSE + 1)) ;;
                *) die "$(printf "$(_ 'unknown option: -%s')" "$opt")" ;;
                esac
            done
            shift
            ;;
        --verbose)
            VERBOSE=$((VERBOSE + 1))
            shift
            ;;
        -q|--quiet) QUIET=1; shift ;;
        -o|--distro)
            [[ $# -ge 2 ]] || die "$(_ 'usage: lrm [-o|--distro NAME] COMMAND ...')"
            LRM_DISTRO="$2"
            shift 2
            ;;
        -l|--list-distros)
            list_supported_distros
            exit 0
            ;;
        -h|--help) usage; exit 0 ;;
        --version) version; exit 0 ;;
        --) shift; break ;;
        -*) die "$(printf "$(_ 'unknown option: %s')" "$1")" ;;
        *) break ;;
        esac
    done

    if [[ $# -lt 1 ]]; then
        usage >&2
        exit 1
    fi

    export VERBOSE QUIET LRM_DISTRO LRM_DISTRO_ID LRM_RELEASE LRM_DISTRO_KEY
    init_lrm

    local cmd="$1"
    shift
    vlog2 "command: $cmd $*"
    load_distro_backend
    case "$cmd" in
    list) cmd_list "$@" ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    use) cmd_use "$@" ;;
    pingtest) cmd_pingtest "$@" ;;
    bwtest) cmd_bwtest "$@" ;;
    pingsel) cmd_pingsel "$@" ;;
    bwsel) cmd_bwsel "$@" ;;
    help) usage ;;
    version) version ;;
    *)
        die "$(printf "$(_ 'unknown command: %s')" "$cmd")"
        ;;
    esac
}

main "$@"
