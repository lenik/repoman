#: lrm.in:70 lrm.in:71
msgid "usage: lrm list [-p|--priority]"
msgstr "用法：lrm list [-p|--priority]"

#: lrm.in:77 lib/common.sh:610 lib/common.sh:640
msgid "no mirrors configured"
msgstr "未配置镜像"

#: lrm.in:90 lrm.in:99 lrm.in:104
msgid "usage: lrm add [[-PRIORITY] | -p|--priority N] ALIAS URL"
msgstr "用法：lrm add [[-PRIORITY] | -p|--priority N] ALIAS URL"

#: lrm.in:114
msgid "added %s (priority %s) %s"
msgstr "已添加 %s（优先级 %s）%s"

#: lrm.in:120
msgid "usage: lrm remove ALIAS|NUM"
msgstr "用法：lrm remove ALIAS|NUM"

#: lrm.in:127
msgid "removed %s"
msgstr "已移除 %s"

#: lrm.in:142 lrm.in:147 lrm.in:152 lrm.in:153
msgid "usage: lrm pingtest [-n|--count N] [-W|--timeout SEC]"
msgstr "用法：lrm pingtest [-n|--count N] [-W|--timeout SEC]"

#: lrm.in:163 lrm.in:168 lrm.in:169
msgid "usage: lrm bwtest [--ref BYTES]"
msgstr "用法：lrm bwtest [--ref BYTES]"

#: lrm.in:195
msgid "no mirror passed ping test"
msgstr "没有镜像通过 ping 测试"

#: lrm.in:197
msgid "selected %s (lowest latency)"
msgstr "已选择 %s（延迟最低）"

#: lrm.in:208
msgid "no mirror passed bandwidth test"
msgstr "没有镜像通过带宽测试"

#: lrm.in:210
msgid "selected %s (highest score)"
msgstr "已选择 %s（得分最高）"

#: lrm.in:222
msgid "unknown option: -%s"
msgstr "未知选项：-%s"

#: lrm.in:235 lib/debian.sh:91 lib/debian.sh:161 lib/rpm.sh:61 lib/rpm.sh:101
#: lib/arch.sh:56 lib/arch.sh:96
msgid "unknown option: %s"
msgstr "未知选项：%s"

#: lrm.in:264
msgid "unknown command: %s"
msgstr "未知命令：%s"

#: lib/common.sh:68
msgid "missing required commands: %s"
msgstr "缺少必需命令：%s"

#: lib/common.sh:103
msgid "root privileges required to write %s (run as root or install sudo)"
msgstr "写入 %s 需要 root 权限（请以 root 运行或安装 sudo）"

#: lib/common.sh:118
msgid "root privileges required (run as root or install sudo)"
msgstr "需要 root 权限（请以 root 运行或安装 sudo）"

#: lib/common.sh:272
msgid "mirror number out of range: %s (1-%s)"
msgstr "镜像编号超出范围：%s（1-%s）"

#: lib/common.sh:278 lib/common.sh:331 lib/common.sh:414
msgid "mirror not found: %s"
msgstr "未找到镜像：%s"

#: lib/common.sh:284
msgid "invalid alias: %s"
msgstr "无效别名：%s"

#: lib/common.sh:291
msgid "invalid mirror URL (must start with http:// or https://): %s"
msgstr "无效镜像 URL（必须以 http:// 或 https:// 开头）：%s"

#: lib/common.sh:425
msgid "using mirror %s (%s)"
msgstr "使用镜像 %s（%s）"

#: lib/debian.sh:83 lib/debian.sh:141
msgid "usage: --suite SUITE"
msgstr "用法：--suite SUITE"

#: lib/debian.sh:89
msgid "option %s belongs before the command name or on pingtest/bwtest"
msgstr "选项 %s 应放在命令名之前，或用于 pingtest/bwtest"

#: lib/debian.sh:93 lib/debian.sh:162 lib/rpm.sh:63 lib/rpm.sh:102
#: lib/arch.sh:58 lib/arch.sh:97
msgid "unexpected argument: %s"
msgstr "意外参数：%s"

#: lib/debian.sh:100
msgid ""
"usage: lrm use [-c|--config-only] [-a|--all] [-s|--src] [-u|--updates] [-b|--"
"backports] [--security] ALIAS|NUM"
msgstr "用法：lrm use [-c|--config-only] [-a|--all] [-s|--src] [-u|--updates] [-b|--backports] [--security] ALIAS|NUM"

#: lib/debian.sh:146 lib/rpm.sh:86 lib/arch.sh:81
msgid "usage: -n|--count N"
msgstr "用法：-n|--count N"

#: lib/debian.sh:151 lib/rpm.sh:91 lib/arch.sh:86
msgid "usage: -W|--timeout SEC"
msgstr "用法：-W|--timeout SEC"

#: lib/debian.sh:156 lib/rpm.sh:96 lib/arch.sh:91
msgid "usage: --ref BYTES"
msgstr "用法：--ref BYTES"

#: lib/debian.sh:241 lib/debian.sh:244
msgid "warning: apt-get update failed"
msgstr "警告：apt-get update 失败"

#: lib/debian.sh:268 lib/rpm.sh:46 lib/arch.sh:42
msgid "wrote %s"
msgstr "已写入 %s"

#: lib/rpm.sh:58 lib/rpm.sh:83 lib/arch.sh:53 lib/arch.sh:78
msgid "option %s is only supported on Debian-based systems"
msgstr "选项 %s 仅适用于 Debian 系系统"

#: lib/rpm.sh:70 lib/arch.sh:65
msgid "usage: lrm use [-c|--config-only] ALIAS|NUM"
msgstr "用法：lrm use [-c|--config-only] ALIAS|NUM"

#: lib/arch.sh:40
msgid "warning: pacman -Syy failed"
msgstr "警告：pacman -Syy 失败"

#: lib/detect.sh:28
msgid "unsupported distribution family: %s"
msgstr "不支持的发行版族：%s"

#: lib/seed.sh:35
msgid "no built-in default mirrors for distribution family: %s"
msgstr "发行版族 %s 没有内置默认镜像"

#: lib/usage.sh:7
msgid "Usage: lrm [OPTION]... COMMAND [ARGS]..."
msgstr "用法：lrm [选项]... 命令 [参数]..."

#: lib/usage.sh:9
msgid "Manage distribution package mirrors and select the fastest one."
msgstr "管理软件源镜像并选择最快的一个。"

#: lib/usage.sh:11
msgid "Options:"
msgstr "选项："

#: lib/usage.sh:12
msgid ""
"  -v, --verbose      more logging (repeatable: -v tests, -vv paths, -vvv "
"metrics, -vvvv trace)"
msgstr "  -v, --verbose      更多日志（可重复：-v 测试，-vv 路径，-vvv 指标，-vvvv 跟踪）"

#: lib/usage.sh:13
msgid "  -q, --quiet        less logging"
msgstr "  -q, --quiet        减少日志输出"

#: lib/usage.sh:14
msgid "  -h, --help         show this help"
msgstr "  -h, --help         显示此帮助"

#: lib/usage.sh:15
msgid "      --version      show version"
msgstr "      --version      显示版本"

#: lib/usage.sh:17
msgid "Commands:"
msgstr "命令："

#: lib/usage.sh:18
msgid "  list [-p|--priority]"
msgstr "  list [-p|--priority]"

#: lib/usage.sh:19
msgid ""
"                     list mirrors: MARK [N] ALIAS (* selected, - bad, ? "
"untested)"
msgstr "                     列出镜像：标记 [N] 别名（* 已选，- 失败，? 未测）"

#: lib/usage.sh:20
msgid "  add [[-PRIORITY] | -p|--priority N] ALIAS URL"
msgstr "  add [[-PRIORITY] | -p|--priority N] ALIAS URL"

#: lib/usage.sh:21
msgid "                     add or update a mirror (default priority 100)"
msgstr "                     添加或更新镜像（默认优先级 100）"

#: lib/usage.sh:22
msgid "  remove ALIAS|NUM   remove a mirror"
msgstr "  remove ALIAS|NUM   移除镜像"

#: lib/usage.sh:23
msgid ""
"  use [-c|--config-only] [-a|--all] [-s|--src] [-u|--updates] [-b|--"
"backports]"
msgstr "  use [-c|--config-only] [-a|--all] [-s|--src] [-u|--updates] [-b|--backports]"

#: lib/usage.sh:24
msgid "                     [--security] [--suite SUITE] ALIAS|NUM"
msgstr "                     [--security] [--suite SUITE] ALIAS|NUM"

#: lib/usage.sh:25
msgid ""
"                     apply mirror (default: all components, src, updates, "
"backports, security)"
msgstr "                     应用镜像（默认：全部组件、源码、更新、backports、security）"

#: lib/usage.sh:26
msgid "  pingtest [-n|--count N] [-W|--timeout SEC]"
msgstr "  pingtest [-n|--count N] [-W|--timeout SEC]"

#: lib/usage.sh:27
msgid "                     ping all mirrors; list by latency"
msgstr "                     ping 所有镜像；按延迟列出"

#: lib/usage.sh:28
msgid "  bwtest [--ref BYTES]"
msgstr "  bwtest [--ref BYTES]"

#: lib/usage.sh:29
msgid "                     download test on all mirrors; list by score"
msgstr "                     对所有镜像下载测试；按得分列出"

#: lib/usage.sh:30
msgid "  pingsel [apply opts] [-n|--count N] [-W|--timeout SEC]"
msgstr "  pingsel [apply opts] [-n|--count N] [-W|--timeout SEC]"

#: lib/usage.sh:31
msgid "                     pingtest then use the best mirror"
msgstr "                     先 pingtest 再应用最佳镜像"

#: lib/usage.sh:32
msgid "  bwsel [apply opts] [--ref BYTES]"
msgstr "  bwsel [apply opts] [--ref BYTES]"

#: lib/usage.sh:33
msgid "                     bwtest then use the best mirror"
msgstr "                     先 bwtest 再应用最佳镜像"

#: lib/usage.sh:34
msgid "  help               show this help"
msgstr "  help               显示此帮助"

#: lib/usage.sh:35
msgid "  version            show version"
msgstr "  version            显示版本"

